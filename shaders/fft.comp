#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
void main() {
    uint b=invocation(); if(b>=p.fft_n/2) return;
    uint shift=uint(findMSB(p.stage));
    uint halfsize=p.stage>>1,j=b&(halfsize-1),i=((b>>(shift-1))<<shift)+j;
    precise vec2 u=a[i],v=multiply(a[i+halfsize],twiddle(p.stage,j));
    a[i]=u+v; a[i+halfsize]=u-v;
}
