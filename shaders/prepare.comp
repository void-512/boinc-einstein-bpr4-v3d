#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x; if(i>=p.n) return;
    float v=i<p.steps?raw[i]:partial[0];
    raw[i]=v;
    uint source=(p.stage&0x80000000u)!=0?i:(bitfieldReverse(i)>>(32-p.logn));
    a[i]=vec2(source<p.steps?raw[source]:partial[0],0);
}
