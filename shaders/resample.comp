#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
shared float sums[256];
void main() {
    uint i=gl_GlobalInvocationID.x, t=gl_LocalInvocationID.x;
    float value=0;
    if(i<p.steps) {
        precise float time=float(i)*p.dt;
        precise float phase=p.omega*time+p.psi;
        precise float offset=p.tau*sine(phase)*p.step_inv-p.s0;
        precise float index=float(i)-offset;
        // Addition of 0.5 in FP32 can round up before truncation for large indices.
        // floor(index) + test fractional part matches the CPU's double addition.
        int j=int(floor(index))+int(index-floor(index)>=0.5);
        if(j<0 || j>=int(p.unpadded)) atomicOr(overflow,2);
        else value=input_data[j];
        raw[i]=value;
    }
    sums[t]=value;
    for(uint k=t+gl_WorkGroupSize.x;k<256;k+=gl_WorkGroupSize.x) sums[k]=0;
    barrier();
    for(uint d=128;d>0;d>>=1) { if(t<d) sums[t]+=sums[t+d]; barrier(); }
    if(t==0) partial[gl_WorkGroupID.x]=sums[0];
}
